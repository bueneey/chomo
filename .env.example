# ── Chomo config ─────────────────────────────────────────────────
# Copy to .env and fill in.

# Server-only — never commit a real key, never prefix with VITE_
HELIUS_API_KEY=

# Public client config
VITE_TOKEN_CA=
VITE_WALLET_ADDRESS=
VITE_WALLET_EXPLORER_URL=

VITE_FOMO_USERNAME=
VITE_FOMO_PROFILE_URL=
VITE_FOMO_APP_URL=https://fomo.family/

VITE_X_HANDLE=
VITE_X_URL=

VITE_GITHUB_URL=https://github.com/bueneey/chomo

VITE_STARTING_BANKROLL=100
VITE_SITE_URL=https://chomo.fun
VITE_TOKEN_TICKER=CHOMO
VITE_TOKEN_NAME=Chomo the Trader

VITE_API_BASE=/api
