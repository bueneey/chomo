# ── Chomo public config ──────────────────────────────────────────
# Copy to .env and fill in. All VITE_* vars are exposed to the client.

# Token contract address (CA)
VITE_TOKEN_CA=

# Trading wallet
VITE_WALLET_ADDRESS=
VITE_WALLET_EXPLORER_URL=

# FOMO
VITE_FOMO_USERNAME=
VITE_FOMO_PROFILE_URL=
VITE_FOMO_APP_URL=https://fomo.family/

# X / Twitter
VITE_X_HANDLE=
VITE_X_URL=

# GitHub
VITE_GITHUB_URL=https://github.com/bueneey/chomo

# Bankroll
VITE_STARTING_BANKROLL=100

# Optional site / token meta
VITE_SITE_URL=
VITE_TOKEN_TICKER=CHOMO
VITE_TOKEN_NAME=Chomo the Trader
